# Required
DATABASE_URL=postgres://user:password@host:5432/yeehaw
ADMIN_TOKEN=at-least-32-random-characters-from-gen-keys
CONFIG_SIGNING_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Optional
PORT=8080
# Number of reverse proxies in front of the app (Render/Cloudflare = 1 or 2); controls req.ip
TRUST_PROXY=1
# Set to "disable" only if your database provider does not use TLS (local dev)
PGSSL=
