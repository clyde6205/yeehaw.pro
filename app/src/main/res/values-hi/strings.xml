    <string name="msg_link_wants_external_app">यह लिंक एक बाहरी ऐप्लिकेशन (%1$s) खोलना चाहता है। केवल तभी जारी रखें जब आप इस पेज पर भरोसा करते हों।</string>
    <string name="msg_private_requests_camera_mic">%1$s कैमरा या माइक्रोफ़ोन तक पहुँच माँग रहा है।</string>
    <string name="msg_private_requests_location">%1$s डिवाइस की लोकेशन माँग रहा है।</string>
    <string name="msg_private_save_outside">\"%1$s\" को डिवाइस के साझा डाउनलोड फ़ोल्डर में सेव किया जाएगा। इस निजी विंडो को बंद करने के बाद भी फ़ाइल और Android का डाउनलोड रिकॉर्ड रह सकता है।</string>
    <string name="msg_private_wants_external_app">यह निजी पेज एक बाहरी ऐप्लिकेशन (%1$s) खोलना चाहता है।</string>
    <string name="msg_pro_is_not_available_to_buy">Pro अभी खरीदने के लिए उपलब्ध नहीं है। मुफ़्त ब्राउज़र में सारे टूल काम करते रहते हैं। Pro तभी खुलता है जब Google Play, YeeHaw सर्वर के साथ खरीदारी की पुष्टि कर दे।</string>
    <string name="msg_saved_offline_reading_copies_will_be">सेव की गई ऑफ़लाइन पठन प्रतियाँ इस डिवाइस से हमेशा के लिए हटा दी जाएँगी।</string>
    <string name="msg_share_anonymous_app_health_crashes_a">ऐप की सेहत की गुमनाम जानकारी (क्रैश, ऐप संस्करण, फ़ोन मेमोरी, क्षेत्र) साझा करें। कोई ब्राउज़िंग डेटा नहीं, कोई विज्ञापन आईडी नहीं। आप इसे कभी भी टूल्स से हटा सकते हैं।</string>
    <string name="msg_site_wants_location">%1$s आपके डिवाइस की लोकेशन तक पहुँचना चाहता है।</string>
    <string name="msg_site_wants_permission">%1$s आपका %2$s इस्तेमाल करना चाहता है। केवल तभी जारी रखें जब आप इस वेबसाइट पर भरोसा करते हों।</string>
    <string name="msg_storage_protection">फ़ोन में खाली जगह: %2$s में से %1$s\nस्थिति: %3$s\n\nYeeHaw डेटा (बुकमार्क, इतिहास, सेव किए पेज): %4$s\nअस्थायी कैश: %5$s\n\nYeeHaw आपके सेव किए पेज, बुकमार्क या इतिहास को कभी अपने-आप नहीं हटाता। कैश साफ़ करने से केवल अस्थायी फ़ाइलें हटती हैं; साइटें एक बार थोड़ी धीमी लोड हो सकती हैं।</string>
    <string name="msg_this_cannot_be_undone">इसे वापस नहीं किया जा सकता।</string>
    <string name="msg_this_clears_history_bookmarks_saved">इससे इतिहास, बुकमार्क, सेव किए ऑफ़लाइन पेज, कुकी, कैश फ़ाइलें और वेबसाइट स्टोरेज साफ़ हो जाएँगे। आप साइन आउट हो सकते हैं।</string>
    <string name="msg_this_deletes_yeehaw_s_anonymous_app">इससे हमारे सर्वर से इस फ़ोन का गुमनाम ऐप-सेहत रिकॉर्ड हट जाएगा और साझा करना बंद हो जाएगा। आपके बुकमार्क और पेज आपके फ़ोन पर ही रहेंगे।</string>
